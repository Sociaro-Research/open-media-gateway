# Public API
PORT=8080
CLIENT_API_KEY=replace-with-a-long-random-value
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
SESSION_SIGNING_SECRET=
SESSION_TTL=720h
# Configure email delivery in Administration > Settings. These optional
# legacy credentials seed an untouched installation once; console edits win.
# AUTH_PUBLIC_URL defaults to the Google callback origin; set it for email-only deployments.
AUTH_PUBLIC_URL=
# UI is an optional separate service: docker compose --profile ui up --build.
# UI return links default to AUTH_PUBLIC_URL; keep browser API proxying on the same origin.
UI_PUBLIC_URL=
UI_PORT=8088
# Separate documentation origin requires AUTH_PUBLIC_URL; DOCS_HOST configures the UI server.
DOCS_HOST=docs.invalid
# Optional controlled parent domain for the theme preference cookie only.
THEME_COOKIE_DOMAIN=
DOCS_PUBLIC_URL=
RESEND_API_KEY=
# A sender address on your verified Resend domain, e.g. Sociaro <login@example.com>.
EMAIL_FROM=
WEBHOOK_SIGNING_SECRET=replace-with-an-independent-long-random-value

# mock is the safe default. A task can still select any configured provider.
MEDIA_PROVIDER=mock
DEFAULT_MEDIA_MODEL=
MOCK_DELAY=2s
MOCK_RESULT_BASE_URL=embedded

# BytePlus ModelArk / ByteDance. No regional endpoint or model is guessed.
BYTEDANCE_API_KEY=
BYTEDANCE_BASE_URL=
BYTEDANCE_MODEL=
# Optional Johor virtual portrait library management; separate AK/SK, not inference/billing keys.
BYTEPLUS_ASSET_ACCESS_KEY_ID=
BYTEPLUS_ASSET_SECRET_ACCESS_KEY=
BYTEPLUS_ASSET_PROJECT=default
BYTEPLUS_ASSET_REGION=ap-southeast-1
BYTEPLUS_BILLING_ACCESS_KEY_ID=
BYTEPLUS_BILLING_SECRET_ACCESS_KEY=

# Alibaba Cloud Model Studio, native DashScope API. Put your key here.
# The default endpoint is Singapore/international. The API key and endpoint
# must belong to the same region. Workspace-specific endpoints are supported.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_MODEL=wan2.7-t2v

# Fun-Music is currently Beijing-only. If the main key/base URL are Beijing,
# these may stay empty. For a Singapore main key, set a separate Beijing pair.
DASHSCOPE_MUSIC_API_KEY=
DASHSCOPE_MUSIC_BASE_URL=
ALIBABA_BILLING_ACCESS_KEY_ID=
ALIBABA_BILLING_ACCESS_KEY_SECRET=

# Worker tuning
# Native processes only: empty disables the dedicated metrics listener.
# Compose sets :9091 internally for each service and never publishes it.
METRICS_ADDR=
# Prometheus UI binds to localhost; enable with --profile monitoring.
PROMETHEUS_PORT=9090
PROVIDER_POLL_INTERVAL=1s
PROVIDER_TASK_TIMEOUT=30m
MAX_POLL_ERRORS=5
PROVIDER_HTTP_TIMEOUT=30s
# Outbound provider/storage/media requests reject private, loopback and metadata
# addresses. Only operators may allow exact trusted self-hosted destinations.
# Empty by default; no wildcards, URLs or ports. Example: storage.internal
OUTBOUND_ALLOW_PRIVATE_HOSTS=
DISPATCH_INTERVAL=1s
# Allow current synchronous provider calls and transfers to finish during release.
# Keep the container/release stop budget longer than the worker drain budget.
WORKER_SHUTDOWN_TIMEOUT=25m
WORKER_STOP_GRACE_PERIOD=26m
WEBHOOK_HTTP_TIMEOUT=10s
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE=1s

# Default result storage for accounts without saved settings.
# Configure S3/R2/B2 per account in the console Storage page. Keep this local.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/media
STORAGE_MAX_BYTES=2147483648
STORAGE_DOWNLOAD_TIMEOUT=5m
MEDIA_URL_SIGNING_SECRET=replace-with-an-independent-long-random-value
# Used to encrypt provider API keys and S3 credentials stored in Postgres. If omitted, the media
# URL signing secret is used for backward-compatible local development.
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=replace-with-an-independent-long-random-value
MEDIA_URL_TTL=1h

# OpenAI: Image API, Speech API and bounded audio Chat Completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-image-2.5-flare

# Agnes AI: image generation/editing and asynchronous video generation.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-image-2.5-flash

# Sonilo: music, sound effects, scored video and narration ducking.
SONILO_API_KEY=
SONILO_BASE_URL=https://api.sonilo.com/v1
SONILO_MODEL=text-to-music
# Account-confirmed USD/second tariffs for operations without published rates.
SONILO_VIDEO_MUSIC_PRICE=
SONILO_VIDEO_SFX_PRICE=
SONILO_SOUND_PRICE=
SONILO_VIDEO_SOUND_PRICE=

# Concurrent current operations per worker (1-256); pending jobs release their
# slot between polls. Intake pauses before dequeueing when all slots are occupied.
WORKER_OPERATION_CONCURRENCY=64
# Concurrent result downloads/uploads per worker; cap disk/network pressure.
ARCHIVE_CONCURRENCY=4
