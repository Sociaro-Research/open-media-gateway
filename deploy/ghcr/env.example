# The release builder replaces the image references with a version or digest.
COMPOSE_FILE=compose.yaml:compose.release.yaml
COMPOSE_PROFILES=ui
COMPOSE_PROJECT_NAME=media-gateway
GATEWAY_IMAGE=ghcr.io/sociaro-research/media-gateway-dev/gateway:@VERSION@
UI_IMAGE=ghcr.io/sociaro-research/media-gateway-dev/ui:@VERSION@
POSTGRES_IMAGE=ghcr.io/sociaro-research/media-gateway-dev/postgres:@VERSION@
REDIS_IMAGE=ghcr.io/sociaro-research/media-gateway-dev/redis:@VERSION@

# initialize.py generates independent secrets; never regenerate on an upgrade.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CLIENT_API_KEY=
SESSION_SIGNING_SECRET=
WEBHOOK_SIGNING_SECRET=
MEDIA_URL_SIGNING_SECRET=
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# initialize.py --public-url https://gateway.example.com enables managed HTTPS.
PORT=8080
UI_PORT=8088
AUTH_PUBLIC_URL=http://localhost:8088
UI_PUBLIC_URL=http://localhost:8088
GATEWAY_HOST=
DOCS_HOST=docs.invalid
DOCS_PUBLIC_URL=

# Configure paid generation, login, payments and storage through Administration.
MEDIA_PROVIDER=mock
MOCK_DELAY=2s
MOCK_RESULT_BASE_URL=embedded
WORKER_OPERATION_CONCURRENCY=64
WORKER_SHUTDOWN_TIMEOUT=25m
WORKER_STOP_GRACE_PERIOD=26m
STORAGE_DRIVER=local
STORAGE_MAX_BYTES=2147483648
# Optional: COMPOSE_PROFILES=ui,monitoring. No public metrics/Grafana ports.
PROMETHEUS_PORT=9090
